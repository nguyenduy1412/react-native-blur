{
  "name": "@nguyenduy1412/react-native-blur",
  "version": "2.0.1",
  "description": "React Native blur view for React Native CLI and Expo: backdrop blur and frosted glass for headers, tab bars, cards and popups, plus content and video blur. Native iOS materials and Android RenderEffect matched to iOS.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "react-native": "index.tsx",
  "source": "index.tsx",
  "files": [
    "build",
    "src",
    "index.tsx",
    "README.md",
    "llms.txt",
    "llms-full.txt",
    "android",
    "ios",
    "NguyenduyBlur.podspec",
    "!android/build",
    "!android/.gradle",
    "!ios/build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "post:article": "node scripts/post-to-devto.js"
  },
  "keywords": [
    "react-native",
    "react-native-blur",
    "blur",
    "blur-view",
    "blurview",
    "react-native-blur-view",
    "expo",
    "expo-blur",
    "backdrop-blur",
    "frosted-glass",
    "glassmorphism",
    "liquid-glass",
    "video-blur",
    "visual-effect",
    "uivisualeffectview",
    "rendereffect",
    "ios",
    "android",
    "backdrop",
    "backdrop-filter",
    "blur-background",
    "frosted-glass-effect",
    "glass-effect",
    "sticky-header",
    "tab-bar",
    "react-native-cli",
    "fabric",
    "new-architecture"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenduy1412/react-native-blur.git"
  },
  "bugs": {
    "url": "https://github.com/nguyenduy1412/react-native-blur/issues"
  },
  "homepage": "https://kaizer-app.vercel.app",
  "author": {
    "name": "nguyenduy1412",
    "url": "https://kaizer-app.vercel.app"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "typescript": "^6.0.3"
  },
  "codegenConfig": {
    "name": "NguyenduyBlurViewSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.nguyenduy.blur"
    },
    "ios": {
      "componentProvider": {
        "NguyenduyBlurView": "NguyenduyBlurViewComponentView"
      }
    }
  }
}
