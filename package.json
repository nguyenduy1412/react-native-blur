{
  "name": "@nguyenduy1412/react-native-blur",
  "version": "1.1.2",
  "description": "React Native blur view for Expo and bare React Native: backdrop blur and frosted glass for headers, tab bars, cards and popups, plus content and video blur. Native iOS materials and Android RenderEffect matched to iOS.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "react-native": "index.tsx",
  "source": "index.tsx",
  "files": [
    "build",
    "index.tsx",
    "llms.txt",
    "android",
    "ios",
    "expo-module.config.json",
    "!android/build",
    "!android/.gradle",
    "!ios/build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "react-native-blur",
    "blur",
    "blur-view",
    "blurview",
    "react-native-blur-view",
    "expo",
    "expo-blur",
    "expo-module",
    "backdrop-blur",
    "frosted-glass",
    "glassmorphism",
    "liquid-glass",
    "video-blur",
    "visual-effect",
    "uivisualeffectview",
    "rendereffect",
    "ios",
    "android",
    "backdrop",
    "backdrop-filter",
    "blur-background",
    "frosted-glass-effect",
    "glass-effect",
    "sticky-header",
    "tab-bar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenduy1412/react-native-blur.git"
  },
  "bugs": {
    "url": "https://github.com/nguyenduy1412/react-native-blur/issues"
  },
  "homepage": "https://kaizer-app.vercel.app",
  "author": {
    "name": "nguyenduy1412",
    "url": "https://kaizer-app.vercel.app"
  },
  "license": "MIT",
